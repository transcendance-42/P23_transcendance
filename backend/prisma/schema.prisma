generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model dog_pics {
  id        BigInt @id @default(autoincrement())
  dog_id    BigInt
  file_path String @db.VarChar(500)
  position  Int?
  dogs      dogs   @relation(fields: [dog_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dogs {
  id                                BigInt     @id @default(autoincrement())
  owner_id                          BigInt
  dog_name                          String     @db.VarChar(50)
  gender                            String?    @db.VarChar(50)
  breed                             String?    @db.VarChar(50)
  age                               Int?
  size                              String?    @db.VarChar(20)
  bio                               String
  created_at                        DateTime?  @default(now()) @db.Timestamp(6)
  dog_pics                          dog_pics[]
  users                             users      @relation(fields: [owner_id], references: [id], onUpdate: NoAction)
  matches_matches_id_dog1Todogs     matches[]  @relation("matches_id_dog1Todogs")
  matches_matches_id_dog2Todogs     matches[]  @relation("matches_id_dog2Todogs")
  swipes_swipes_swiped_dog_idTodogs swipes[]   @relation("swipes_swiped_dog_idTodogs")
  swipes_swipes_swiper_dog_idTodogs swipes[]   @relation("swipes_swiper_dog_idTodogs")
}

model matches {
  id                         BigInt     @id @default(autoincrement())
  id_dog1                    BigInt
  id_dog2                    BigInt
  created_at                 DateTime?  @default(now()) @db.Timestamp(6)
  dogs_matches_id_dog1Todogs dogs       @relation("matches_id_dog1Todogs", fields: [id_dog1], references: [id], onUpdate: NoAction)
  dogs_matches_id_dog2Todogs dogs       @relation("matches_id_dog2Todogs", fields: [id_dog2], references: [id], onUpdate: NoAction)
  messages                   messages[]

  @@unique([id_dog1, id_dog2], map: "unique_match")
}

model messages {
  id        BigInt    @id @default(autoincrement())
  match_id  BigInt
  sender_id BigInt
  content   String
  send_at   DateTime? @default(now()) @db.Timestamp(6)
  matches   matches   @relation(fields: [match_id], references: [id], onUpdate: NoAction)
  users     users     @relation(fields: [sender_id], references: [id], onUpdate: NoAction)
}

model swipes {
  id                              BigInt    @id @default(autoincrement())
  swiper_dog_id                   BigInt
  swiped_dog_id                   BigInt
  direction                       String    @db.VarChar(7)
  created_at                      DateTime? @default(now()) @db.Timestamp(6)
  dogs_swipes_swiped_dog_idTodogs dogs      @relation("swipes_swiped_dog_idTodogs", fields: [swiped_dog_id], references: [id], onUpdate: NoAction)
  dogs_swipes_swiper_dog_idTodogs dogs      @relation("swipes_swiper_dog_idTodogs", fields: [swiper_dog_id], references: [id], onUpdate: NoAction)
}

model users {
  id            BigInt     @id @default(autoincrement())
  email         String     @unique @db.VarChar(100)
  password_hash String?    @db.VarChar(255)
  first_name    String     @db.VarChar(50)
  last_name     String     @db.VarChar(50)
  city          String     @db.VarChar(100)
  date_of_birth DateTime   @db.Date
  avatar        String?    @db.VarChar(500)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  is_active     Boolean    @default(true)
  dogs          dogs[]
  messages      messages[]
}
